# expect: I2 I4
# Two requests share the id r1. I2 must reject the history. I4 pairs an answer with the latest
# request of its id before it, so the 300 wpm answer to "drift off to sleep" is caught.
shoke-history/v1
meta deadline_ms=8000
meta max_calls=2
500 req id=r1 text=drift%20off%20to%20sleep
900 decision req=r1 source=model wpm=300 sound=2 visual=1 book=0
30000 req id=r1 text=fast
