# expect: I3
# During an outage r1 got a fallback plan, and it was cached. When the provider recovered, r2
# (the same request in different case) was still served the degraded plan from the cache.
shoke-history/v1
meta deadline_ms=8000
meta max_calls=2
500 req id=r1 text=Hello%20world
503 call req=r1 n=1
900 resp req=r1 n=1 status=http_503
1150 call req=r1 n=2
1400 resp req=r1 n=2 status=http_503
1400 decision req=r1 source=fallback wpm=200 sound=2 visual=1 book=0
20000 req id=r2 text=hello%20WORLD
20002 decision req=r2 source=cache origin=fallback wpm=200 sound=2 visual=1 book=0
